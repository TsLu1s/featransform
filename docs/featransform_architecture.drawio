        <mxCell id="c-575" value="&lt;span style=&quot;font-size:13px;color:#9a3412;font-family:JetBrains Mono;font-weight:bold;&quot;&gt;transform(X_new)  →  DataFrame&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=6;spacingTop=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="882" y="2100" width="310" height="22" as="geometry"/></mxCell>
        <mxCell id="c-576" value="&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;1  align to the fit column order&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;font-family:JetBrains Mono;&quot;&gt;   extras ignored · missing → error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;2  replay datetime · imputer ·&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;   encoder · scaler · ensembles&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;3  keep the 11 selected columns&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;4  check against the fit schema&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;font-family:JetBrains Mono;&quot;&gt;   nothing is refit&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=6;spacingTop=6;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="882" y="2128" width="310" height="160" as="geometry"/></mxCell>
