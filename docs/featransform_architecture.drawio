        <mxCell id="c-489" value="0.784" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e1e4e8;fillColor=#ffffff;fontColor=#334155;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;align=center;verticalAlign=middle;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="1230" y="1526" width="64" height="24" as="geometry"/></mxCell>
        <mxCell id="c-490" value="full set, score reused" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#e1e4e8;fillColor=#ffffff;fontColor=#334155;fontSize=10;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;align=center;verticalAlign=middle;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="1294" y="1526" width="246" height="24" as="geometry"/></mxCell>
        <mxCell id="c-491" value="&lt;span style=&quot;font-size:11px;color:#0f172a;font-weight:bold;&quot;&gt;How to read it&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Ten thresholds yield six distinct subsets: t = 0.50 – 0.72&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;all fall under the 10-column floor and are scored once.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;11 and 14 columns tie at F1 0.800, so the smaller wins.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;6 of the 11 kept columns are engineered (pca_*);&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;customer_id is ranked like any column and falls below the cut.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=6;spacingTop=6;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1080" y="1560" width="470" height="200" as="geometry"/></mxCell>
        <mxCell id="c-492" value="" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e9d5ff;strokeWidth=1;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1722" width="460" height="74" as="geometry"/></mxCell>
        <mxCell id="c-493" value="&lt;span style=&quot;font-size:10px;color:#6b21a8;font-weight:bold;&quot;&gt;Caveat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;The unsupervised models were fit on every row, validation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;included, so read scores as a ranking between subsets,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;not as an unbiased estimate of generalization.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=6;spacingTop=6;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1084" y="1728" width="452" height="64" as="geometry"/></mxCell>
