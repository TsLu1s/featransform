        <mxCell id="c-573" value="&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;400 rows × 11 columns · 5 original + 6 engineered · transform(X_new) returns the same columns&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=6;spacingTop=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="72" y="2258" width="760" height="20" as="geometry"/></mxCell>
