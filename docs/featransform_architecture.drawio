        <mxCell id="c-57" value="&lt;span style=&quot;font-size:12px;color:#0f172a;font-weight:bold;&quot;&gt;Impute Missing&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;font-family:JetBrains Mono;&quot;&gt;numeric: iterative (default)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;font-family:JetBrains Mono;&quot;&gt;only NaN cells are written&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;font-family:JetBrains Mono;&quot;&gt;categorical: fit-time mode&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=4;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;" vertex="1" parent="1"><mxGeometry x="564" y="322" width="210" height="80" as="geometry"/></mxCell>
