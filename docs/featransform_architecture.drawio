        <mxCell id="c-578" value="&lt;span style=&quot;font-size:13px;color:#9a3412;font-weight:bold;&quot;&gt;Fitted pipeline&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=6;spacingTop=0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1232" y="2100" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="c-579" value="&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;get_summary()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;get_feature_importance()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;get_optimization_history()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;get_pipeline_schema()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;font-family:JetBrains Mono;&quot;&gt;PipelineSerializer.save / load&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;font-family:JetBrains Mono;&quot;&gt;   type and version checked&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;font-family:JetBrains Mono;&quot;&gt;training rows are not stored&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingLeft=6;spacingTop=6;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1232" y="2128" width="300" height="160" as="geometry"/></mxCell>
